FROM python:3.13-slim

LABEL org.opencontainers.image.source=https://github.com/craisined/tinyapper

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

EXPOSE 8000
CMD ["gunicorn", "--workers", "4", "--bind", "0.0.0.0:8000", "--worker-tmp-dir", "/dev/shm", "--chdir", "demos/yapperpedia", "app:app"]